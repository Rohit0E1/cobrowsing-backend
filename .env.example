ENABLEX_RECORDING_PASS=

# Cloudflare R2 — recordings are copied here (unset = recordings stay on EnableX)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# Email
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# WhatsApp
WA_API_KEY=
WA_FROM=

# Google Calendar
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
GOOGLE_IMPERSONATE_SUBJECT=

# Vertex AI (copilot)
